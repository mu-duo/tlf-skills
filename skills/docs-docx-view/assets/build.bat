@echo off
rem build.bat - build the generated Word document for docs\docsDocxView.
rem
rem combined.md, _manifest.json, and _meta.json are generated by the
rem docs-docx-view skill. If docs\toc.yml, CONTEXT.md, or the module set changed,
rem re-run that skill first so combined.md is fresh.
rem
rem This helper is build-only: it never generates content, never validates the
rem sources, never installs packages, and never looks for the skill directory.
rem It is yours to edit; docs-docx-view will not overwrite it.
setlocal
pushd "%~dp0"

set "CLEAN=0"
if "%~1"=="" goto :args_ok
if /i "%~1"=="--clean" (
    set "CLEAN=1"
) else (
    goto :usage
)
if not "%~2"=="" goto :usage
:args_ok

if "%CLEAN%"=="1" rmdir /s /q build 2>nul

if defined DOCS_PY (
    set "PY=%DOCS_PY%"
) else (
    set "PY=..\..\.venv-docs\Scripts\python.exe"
)

if exist "%PY%" goto :py_ok
echo error: render env not found at %PY%; run the docs-docx-view skill first.>&2
exit /b 1
:py_ok

for %%F in (combined.md _meta.json _manifest.json reference.docx) do (
    if not exist "%%F" (
        echo error: %%F is missing; run the docs-docx-view skill first.>&2
        exit /b 1
    )
)

for /f "usebackq delims=" %%O in (`"%PY%" -c "import json;print(json.load(open('_meta.json'))['output'])"`) do set "OUT=%%O"
if not defined OUT (
    echo error: cannot read output path from _meta.json; run the docs-docx-view skill first.>&2
    exit /b 1
)

set "PANDOC="
for /f "usebackq delims=" %%P in (`"%PY%" -c "import pypandoc;print(pypandoc.get_pandoc_path())"`) do set "PANDOC=%%P"
if not defined PANDOC (
    echo error: pypandoc is not installed in %PY%; run the docs-docx-view skill first.>&2
    exit /b 1
)

for %%I in ("..\..") do set "ROOT=%%~fI"

mkdir build 2>nul

echo "%PANDOC%" --from=markdown+raw_attribute --to=docx --reference-doc=reference.docx --resource-path="%ROOT%" -o "%OUT%" combined.md

"%PANDOC%" --from=markdown+raw_attribute --to=docx --reference-doc=reference.docx --resource-path="%ROOT%" -o "%OUT%" combined.md 2> build\pandoc.log
set "RC=%errorlevel%"
if not "%RC%"=="0" goto :build_failed

if not exist "%OUT%" (
    echo error: expected output %OUT% was not created; see %CD%\build\pandoc.log>&2
    exit /b 1
)

set "MESSAGES=0"
if exist build\pandoc.log for /f %%C in ('type build\pandoc.log ^| find /c /v ""') do set "MESSAGES=%%C"
for %%S in ("%OUT%") do set "SIZE=%%~zS"

echo Messages: %MESSAGES% (%CD%\build\pandoc.log)
echo Output:   %CD%\%OUT%
echo Size:     %SIZE% bytes
popd
exit /b 0

:build_failed
echo error: pandoc failed (exit %RC%); build\ may contain stale or partial output.>&2
echo log: %CD%\build\pandoc.log>&2
popd
exit /b %RC%

:usage
echo usage: %~nx0 [--clean]>&2
popd
exit /b 2

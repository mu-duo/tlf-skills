# docs-html-view managed Sphinx config (template).
#
# Apply only to the conf.py that sphinx-quickstart just generated for a NEW site:
# copy this file over docs/docsHtmlView/conf.py and replace the __TOKENS__ below,
# then copy assets/guard.py to docs/docsHtmlView/guard.py. For an existing site,
# do not overwrite: show the user a manual merge plan first.
import os
import sys

sys.path.insert(0, os.path.abspath(os.path.dirname(__file__)))

project = __SITE_TITLE__
author = __AUTHOR__
release = __RELEASE__

extensions = ["myst_parser", "guard"]
html_theme = "sphinx_rtd_theme"
html_theme_options = {}

source_suffix = {".md": "markdown", ".rst": "restructuredtext"}
root_doc = "docsHtmlView/index"

# Enumerate exactly: landing page, generated navigation, and the approved trees.
# Deliberately NOT a docsHtmlView/** wildcard, so foreign workspace files are ignored.
include_patterns = [
    "docsHtmlView/index.md",
    "docsHtmlView/nav/**",
    "prd/**",
    "current/**",
    "adr/**",
]

exclude_patterns = [
    "docsHtmlView/build/**",
    "docsHtmlView/.venv*/**",
    ".venv-docs/**",
    "**/.git/**",
]

myst_enable_extensions = ["colon_fence", "deflist", "fieldlist"]
myst_heading_anchors = 3

# Read by guard.py; must list the same roots as include_patterns above.
docs_html_view_allowed_roots = ["prd", "current", "adr"]

@echo off
rem build.bat - build the generated PRD HTML for docs\docsHtmlView.
rem
rem The cover page, section navigation, glossary, _manifest.json, and _meta.json
rem are generated by the docs-html-view skill. If docs\toc.yml, CONTEXT.md, or the
rem module set changed, re-run that skill first so the generated files are fresh.
rem
rem This helper is build-only: it never generates content, never installs
rem packages, and never looks for the skill directory. It is yours to edit;
rem docs-html-view will not overwrite it.
setlocal
cd /d "%~dp0"

set "CLEAN=0"
if "%~1"=="" goto :args_ok
if /i "%~1"=="--clean" (
    set "CLEAN=1"
) else (
    goto :usage
)
if not "%~2"=="" goto :usage
:args_ok

if defined DOCS_PY (
    set "PY=%DOCS_PY%"
) else (
    set "PY=..\..\.venv-docs\Scripts\python.exe"
)

if exist "%PY%" goto :py_ok
echo error: render env not found at %PY%; run the docs-html-view skill first.>&2
exit /b 1
:py_ok

for %%F in (conf.py guard.py _manifest.json _meta.json index.md) do (
    if not exist "%%F" (
        echo error: %%F is missing; run the docs-html-view skill first.>&2
        exit /b 1
    )
)

if "%CLEAN%"=="1" rmdir /s /q build 2>nul
mkdir build 2>nul

echo "%PY%" -m sphinx -b html -c . -d build\doctrees -w build\warnings.log .. build\html

"%PY%" -m sphinx -b html -c . -d build\doctrees -w build\warnings.log .. build\html
set "RC=%errorlevel%"
if not "%RC%"=="0" goto :build_failed

set "WARNINGS=0"
if exist build\warnings.log for /f %%C in ('type build\warnings.log ^| find /c /v ""') do set "WARNINGS=%%C"

echo Entry:    %CD%\build\html\index.html
echo Cover:    %CD%\build\html\docsHtmlView\index.html
echo Warnings: %WARNINGS% (%CD%\build\warnings.log)
exit /b 0

:build_failed
echo error: build failed (exit %RC%); build/ may contain stale or partial output.>&2
echo warnings: %CD%\build\warnings.log>&2
exit /b %RC%

:usage
echo usage: %~nx0 [--clean]>&2
exit /b 2
